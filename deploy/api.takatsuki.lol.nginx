server {
    listen 80;
    listen [::]:80;
    server_name api.takatsuki.lol;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.takatsuki.lol;

    ssl_certificate /etc/letsencrypt/live/api.takatsuki.lol/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.takatsuki.lol/privkey.pem;

    client_max_body_size 64k;
    proxy_connect_timeout 5s;
    proxy_send_timeout 45s;
    proxy_read_timeout 45s;

    location = /healthz {
        proxy_pass http://127.0.0.1:8031;
        proxy_set_header Host $host;
    }

    location /v1/ {
        limit_except POST GET { deny all; }
        proxy_pass http://127.0.0.1:8031;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location / {
        return 404;
    }
}
